@startuml
class Reposicion {
    + Reposicion()
    + Reposicion(id:int, fechaReposicion:DateTime, precioTotal:decimal, comentario:string)
    + Id : int <<get>> <<set>>
    + FechaReposicion : DateTime <<get>> <<set>>
    + PrecioTotal : decimal <<get>> <<set>>
    + Comentario : string? <<get>> <<set>>
}
@enduml
